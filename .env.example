# Online Sequencer 환경 변수 예시
# - 웹(Vite): 빌드 시점에 번들에 들어갑니다. 비밀값을 넣지 마십시오(VITE_ 변수는 누구나 볼 수 있음).
# - 로컬 개발: 이 파일을 .env.development(또는 .env.local)로 복사해 사용합니다.
# - Vercel: Project Settings → Environment Variables에 같은 이름으로 등록하고 다시 배포합니다.
# - 설명: docs/architecture/api-configuration.md

# 코드 기본값은 없습니다. 아래 네 값을 모두 설정하십시오.
# 빠지면 프로덕션 빌드에서 경고하고, 실행 중 해당 기능을 끕니다.

# (필수) jace-s API 주소 (경로에 /api를 붙이지 않음). 없으면 협업·공지·로그인 꺼짐
VITE_API_URL=https://api.jace-s.com

# (필수) jace-s 화면 주소 (로그인 /login, 계정 /account). 없으면 로그인 꺼짐
VITE_SITE_URL=https://jace-s.com

# (필수) jace-s에 등록된 앱 ID (공지 /notices?app=41). 없으면 공지 조회 안 함
VITE_NOTICE_APP_ID=41

# (필수, 운영) 로그인 UI를 보여줄 호스트 (쉼표 구분, 포트·스킴 없이).
# jace-s 서버가 credentials를 허용하는 Origin의 호스트만 넣습니다. 비우면 로그인 UI를 숨깁니다.
# 운영(Vercel Production): online-sequencer.jace-s.com
VITE_LOGIN_HOSTS=

# (선택) TURN 서버. 설정하지 않으면 공개 STUN만 사용합니다.
# 주의: VITE_ 변수는 번들에 노출되므로 장기 고정 자격 증명은 권장하지 않습니다.
VITE_TURN_SERVER_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# (Electron 전용, main 프로세스) 개발자 도구 표시. 기본 false
# Electron은 실행 파일 폴더 등에서 .env.production(패키징) / .env.development(개발)를 읽습니다.
ENABLE_DEVTOOLS=false
